{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/tmp",
			"!dist",
			"!npm-pkg",
			"!pnpm-lock.yaml",
			"!pnpm-workspace.yaml",
			"!gallery/reboot.css",
			"!gallery/themes/*.css"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 90
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"yaml": {
		"formatter": {
			"indentWidth": 2
		}
	},
	"markdown": {
		"parser": {
			"frontmatter": true
		},
		"formatter": {
			"formatEmbeds": false
		}
	},
	"overrides": [
		{
			"includes": ["**/package.json", "**/deno.json", "**/jsr.json"],
			"json": {
				"formatter": {
					"indentStyle": "space",
					"indentWidth": 2
				}
			}
		}
	],
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": {
				"noAutofocus": "warn",
				"noLabelWithoutControl": "warn",
				"useAriaPropsForRole": "warn",
				"useButtonType": "warn",
				"useHeadingContent": "warn",
				"useHtmlLang": "warn"
			},
			"suspicious": {
				"noAssignInExpressions": "warn",
				"useIterableCallbackReturn": "warn"
			}
		}
	}
}
