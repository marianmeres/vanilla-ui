{
	"name": "@marianmeres/vanilla-ui",
	"version": "0.5.2",
	"exports": "./src/mod.ts",
	"compilerOptions": {
		"lib": [
			"deno.ns",
			"dom",
			"dom.iterable",
			"esnext"
		]
	},
	"publish": {
		"exclude": [
			"tmp",
			".env.example"
		]
	},
	"tasks": {
		"test": "deno test --allow-read",
		"test:watch": "deno test --allow-read --watch",
		"test:browser": "deno run -A scripts/browser-test.ts",
		"fingerprint": "deno run -A scripts/render-fingerprint.ts",
		"build": "deno run -A jsr:@marianmeres/deno-build --esbuild --outdir dist --outfile mod.js",
		"build:watch": "deno run -A jsr:@marianmeres/deno-build --esbuild --outdir dist --outfile mod.js --watch",
		"serve": "deno run --allow-net --allow-read jsr:@std/http/file-server . --port 4507",
		"themes:build": "deno run -A gallery/themes/_generate.ts",
		"npm:build": "deno run -A scripts/build-npm.ts",
		"npm:publish": "deno run -A scripts/build-npm.ts && cd ./.npm-dist && npm publish --access=public",
		"release": "deno run -A jsr:@marianmeres/release@^2.1.0 --before-commit \"deno task build\"",
		"publish": "deno publish && deno task npm:publish",
		"rp": "deno task release -y && deno task publish",
		"rpm": "deno task release minor -y && deno task publish"
	},
	"imports": {
		"@marianmeres/design-tokens": "jsr:@marianmeres/design-tokens@^1.20.0",
		"@marianmeres/npmbuild": "jsr:@marianmeres/npmbuild@^1.16.0",
		"@marianmeres/vanilla": "jsr:@marianmeres/vanilla@^1.10.0",
		"@std/assert": "jsr:@std/assert@^1.0.19",
		"@std/fs": "jsr:@std/fs@^1.0.24",
		"@std/http": "jsr:@std/http@^1.1.3",
		"@std/path": "jsr:@std/path@^1.1.6",
		"linkedom": "npm:linkedom@^0.18.13"
	},
	"fmt": {
		"useTabs": true,
		"lineWidth": 90,
		"indentWidth": 4,
		"proseWrap": "preserve",
		"exclude": [
			"dist",
			"gallery/themes/*.css",
			"gallery/reboot.css"
		]
	},
	"minimumDependencyAge": {
		"exclude": [
			"jsr:@marianmeres/*",
			"npm:@marianmeres/*"
		]
	}
}
