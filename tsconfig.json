{
	// Editor + `pnpm run typecheck` view: src, tests, the Node scripts and the gallery's
	// theme generator, no output. Node runs the source with its types stripped and never
	// checks them, so this is the type gate.
	"compilerOptions": {
		"target": "es2024",
		// the index is browser code: src/ is typed against the DOM; @types/node covers
		// the tests (node:test), the scripts (node:http via demino, child_process) and the
		// generator (node:fs)
		"lib": ["es2024", "dom", "dom.iterable"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"types": ["node"],

		"strict": true,
		// noUncheckedIndexedAccess is off: Deno never had it, and the move off Deno
		// changes no code
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"skipLibCheck": true,

		// erasable-only TS: what Node's type stripping can run unchanged
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		// imports keep their `.ts` extension in source; tsc rewrites them to `.js` on emit
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,

		"noEmit": true
	},
	"include": ["src", "tests", "scripts", "gallery"]
}
